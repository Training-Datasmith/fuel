{
    "name": "fuel/fuel",
    "type": "project",
    "description": "FuelPHP is a simple, flexible, community driven PHP 8.2+ application skeleton, based on the best ideas of other frameworks, with a fresh start!",
    "keywords": [
        "application",
        "website",
        "development",
        "framework",
        "PHP",
        "PHP7"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "composer/installers": "~1.0",
        "cweagans/composer-patches": "2.0.0",
        "fuel/core": "1.8.*",
        "fuel/auth": "1.8.*",
        "fuel/email": "1.8.*",
        "fuel/oil": "1.8.*",
        "fuel/orm": "1.8.*",
        "fuel/parser": "1.8.*",
        "fuelphp/upload": "2.0.6"
    },
    "require-dev": {
        "fuel/docs": "1.8.*",
        "phpunit/phpunit": "11.5.57"
    },
    "suggest": {
        "dwoo/dwoo": "Allow Dwoo templating with the Parser package",
        "mustache/mustache": "Allow Mustache templating with the Parser package",
        "smarty/smarty": "Allow Smarty templating with the Parser package",
        "twig/twig": "Allow Twig templating with the Parser package",
        "pyrocms/lex": "Allow Lex templating with the Parser package",
        "mthaml/mthaml": "Allow Haml templating with Twig supports with the Parser package",
        "zordius/lightncandy": "Allow Handlebars templating with an extremely fast PHP implementation of handlebars"
    },
    "config": {
        "vendor-dir": "fuel/vendor",
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "installer-paths": {
            "fuel/{$name}": [
                "fuel/core"
            ],
            "{$name}": [
                "fuel/docs"
            ]
        },
        "patches": {
            "fuel/core": {
                "PHP 8: default missing Content-Type header to empty string": "patches/fuel-core/php8-input-content-type.patch",
                "PHP 8.2: avoid deprecated static:: callable form in Security::clean": "patches/fuel-core/php8-security-callable.patch",
                "PHP 8: cast null request module before ucfirst in Presenter::forge": "patches/fuel-core/php8-presenter-module.patch"
            }
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php oil r install"
        ]
    },
    "minimum-stability": "stable"
}
