{
    "name": "fuel/fuel",
    "type": "project",
    "description": "FuelPHP is a simple, flexible, community driven PHP 8.2+ application skeleton, based on the best ideas of other frameworks, with a fresh start!",
    "keywords": [
        "application",
        "website",
        "development",
        "framework",
        "PHP",
        "PHP7"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.3.0",
        "fuel/core": "dev-remote-test-2026-11-09 as 1.8.99",
        "fuel/auth": "dev-ai-training-20260418 as 1.8.99",
        "fuel/email": "dev-remote-test-2026-10-07 as 1.8.99",
        "fuel/oil": "dev-remote-test-2026-10-07 as 1.8.99",
        "fuel/orm": "dev-remote-test-2026-10-07 as 1.8.99",
        "fuel/parser": "dev-remote-test-2026-10-07 as 1.8.99",
        "fuelphp/upload": "2.0.6",
        "psr/log": "dev-remote-test-2026-10-07 as 3.0.99"
    },
    "require-dev": {
        "fuel/docs": "dev-remote-test-2026-10-07 as 1.8.99",
        "erusev/parsedown": "1.7.4",
        "mustache/mustache": "3.2.0",
        "phpunit/phpunit": "11.5.57"
    },
    "suggest": {
        "dwoo/dwoo": "Allow Dwoo templating with the Parser package",
        "mustache/mustache": "Allow Mustache templating with the Parser package",
        "smarty/smarty": "Allow Smarty templating with the Parser package",
        "twig/twig": "Allow Twig templating with the Parser package",
        "pyrocms/lex": "Allow Lex templating with the Parser package",
        "mthaml/mthaml": "Allow Haml templating with Twig supports with the Parser package",
        "zordius/lightncandy": "Allow Handlebars templating with an extremely fast PHP implementation of handlebars"
    },
    "config": {
        "vendor-dir": "fuel/vendor",
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-paths": {
            "fuel/{$name}": [
                "fuel/core"
            ],
            "{$name}": [
                "fuel/docs"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php oil r install"
        ]
    },
    "minimum-stability": "stable"
}
